# Every variable the app reads, with the role it plays. Copy to .env.local and
# fill in. Never commit a real value.
#
# There are no `NEXT_PUBLIC_*` variables. Nothing here is compiled into the
# browser bundle: the app reads these only from server code (`src/lib/env.ts`
# and `src/lib/db/client.ts`), and the browser's auth client talks to the
# same-origin `/api/auth` proxy. See docs/deploy.md for the full manifest and
# the Vercel runbook.

# --- Database -------------------------------------------------------------
# Pooled connection (Neon's `-pooler` host) used by the running app.
# Required. Server-only.
DATABASE_URL="postgresql://..."

# Direct, unpooled connection. Required only for migrations (`npm run db:migrate`,
# `npm run db:generate`) and for creating the test database. Not read at runtime.
# Server-only.
DATABASE_URL_UNPOOLED="postgresql://..."

# --- Neon Auth (Managed Better Auth) --------------------------------------
# `neon env pull` writes these. Required. Server-only.
NEON_AUTH_BASE_URL="https://....neonauth....neon.tech/neondb/auth"
# Written by `neon env pull`; the app does not read it. Kept so a pulled file is
# complete and the branch's JWKS endpoint is on record.
NEON_AUTH_JWKS_URL="https://....neonauth....neon.tech/neondb/auth/.well-known/jwks.json"

# Signs the session cookie. Required, >= 32 characters, and it must be the same
# value on every deploy: changing it signs everybody out.
# `openssl rand -base64 32`. Server-only, secret.
NEON_AUTH_COOKIE_SECRET=""

# --- Roles ----------------------------------------------------------------
# Comma-separated allowlist; whitespace and case are ignored. These accounts are
# Organizers; everyone else is a Participant. Required in practice: empty means
# nobody can reach the organizer screens. Server-only.
ADMIN_EMAILS="organizer@example.com"

# --- E2B sandboxes --------------------------------------------------------
# Required for Run and the organizer test panel; the app still builds without it.
# Server-only, secret.
E2B_API_KEY=""
# The template built from e2b/Dockerfile by `npm run e2b:build`. Required in
# production: the E2B default template has no JDK, so Java cannot compile
# without this. Server-only. Not a secret — it is a template identifier.
E2B_TEMPLATE_ID=""

# --- Tests only -----------------------------------------------------------
# Written by `npm run db:test:setup` into .env.test.local. Never set in Vercel.
# TEST_DATABASE_URL="postgresql://.../code_feast_test_..."
