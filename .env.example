# Copy to .env.local and fill in. Never commit real values.
# `neon env pull` writes DATABASE_URL, DATABASE_URL_UNPOOLED, NEON_AUTH_*.

# Pooled connection used by the app; unpooled used by migrations.
DATABASE_URL="postgresql://..."
DATABASE_URL_UNPOOLED="postgresql://..."

# Neon Auth (Managed Better Auth) for this branch.
NEON_AUTH_BASE_URL="https://....neonauth....neon.tech/neondb/auth"
NEON_AUTH_JWKS_URL="https://....neonauth....neon.tech/neondb/auth/.well-known/jwks.json"

# >= 32 characters. `openssl rand -base64 32`.
NEON_AUTH_COOKIE_SECRET=""

# Comma-separated allowlist. These accounts are Organizers; everyone else is a Participant.
ADMIN_EMAILS="organizer@example.com"

# E2B sandbox account. Required for Run and the organizer test panel.
E2B_API_KEY=""
# Optional E2B template that has python3, g++, and a JDK installed.
E2B_TEMPLATE_ID=""
